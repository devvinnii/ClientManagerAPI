# Obrigatória para executar a API. Gere uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=

# Opcional: duração do token em milissegundos.
JWT_EXPIRATION_MS=3600000

# Obrigatórias para o banco local via Docker Compose.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# O bootstrap de administrador é opcional e deve ser ativado somente para a inicialização controlada.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
